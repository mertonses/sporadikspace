{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sporadik-space-log",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    "sporadik.space/*",
    "www.sporadik.space/*"
  ],
  "vars": {
    "GITHUB_OWNER": "mertonses",
    "GITHUB_REPO": "sporadikspace",
    "GITHUB_BRANCH": "main"
  },
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
