---
import BaseLayout from "../layouts/BaseLayout.astro";

const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Admin">
  <section class="terminal-block" aria-labelledby="admin-title">
    <div class="section-head">
      <h1 id="admin-title" class="screen-title">PUBLISH PANEL</h1>
      <p class="muted admin-note">private route for sporadik.space</p>
    </div>

    <div class="admin-shell">
      <div class="admin-auth" data-admin-auth>
        <label class="search-label" for="admin-password">password</label>
        <div class="admin-inline">
          <input
            id="admin-password"
            class="search-input"
            type="password"
            autocomplete="current-password"
            placeholder="enter admin password"
          />

          <button class="submit-button" type="button" data-admin-login>
            unlock
          </button>
        </div>
      </div>

      <div class="admin-panel" data-admin-panel hidden>
        <div class="admin-inline admin-toolbar">
          <p class="terminal-line admin-status" data-admin-status>
            session ready.
          </p>

          <button class="provider-pill" type="button" data-admin-logout>
            lock
          </button>
        </div>

        <form class="admin-form" data-admin-form>
          <div class="admin-summary">
            <p class="admin-summary-label">entry path</p>
            <p class="admin-summary-value" data-admin-entry-url>
              /journal/{today}-untitled/
            </p>
            <p class="admin-summary-meta" data-admin-word-count>
              0 words
            </p>
          </div>

          <div class="admin-grid">
            <label>
              <span class="search-label">title</span>
              <input class="search-input" type="text" name="title" required />
            </label>

            <label>
              <span class="search-label">date</span>
              <input class="search-input" type="date" name="date" value={today} required />
            </label>
          </div>

          <label>
            <span class="search-label">description</span>
            <input
              class="search-input"
              type="text"
              name="description"
              placeholder="short deck for homepage and meta"
            />
          </label>

          <label>
            <span class="search-label">tags</span>
            <input
              class="search-input"
              type="text"
              name="tags"
              placeholder="deneme, notlar, gözlem"
            />
          </label>

          <label>
            <span class="search-label">cover image</span>
            <input class="search-input admin-file" type="file" name="image" accept="image/*" />
          </label>

          <figure class="admin-image-preview" data-admin-image-preview hidden>
            <img src="" alt="" data-admin-image-preview-img />
            <figcaption data-admin-image-preview-caption>
              cover preview
            </figcaption>
          </figure>

          <div class="admin-grid">
            <label>
              <span class="search-label">cover alt</span>
              <input
                class="search-input"
                type="text"
                name="coverAlt"
                placeholder="short image description"
              />
            </label>

            <label>
              <span class="search-label">cover caption</span>
              <input
                class="search-input"
                type="text"
                name="coverCaption"
                placeholder="optional caption"
              />
            </label>
          </div>

          <label>
            <span class="search-label">body</span>
            <textarea
              class="search-input admin-textarea"
              name="body"
              placeholder="write in markdown..."
              required
            ></textarea>
          </label>

          <label class="admin-checkbox">
            <input type="checkbox" name="draft" value="true" />
            <span>save as draft</span>
          </label>

          <div class="admin-inline admin-actions">
            <button class="submit-button" type="submit" data-admin-submit>
              publish
            </button>
            <button class="provider-pill" type="button" data-admin-clear-draft>
              clear local draft
            </button>
            <p class="terminal-line admin-feedback" data-admin-feedback></p>
          </div>
        </form>

        <section class="admin-preview" aria-labelledby="admin-preview-title">
          <div class="section-head">
            <h2 id="admin-preview-title" class="screen-title">PREVIEW</h2>
            <p class="muted admin-note" data-admin-draft-note>
              local draft autosaves on this device
            </p>
          </div>

          <article class="admin-preview-card">
            <p class="entry-date" data-admin-preview-date>[{today}]</p>
            <h3 class="admin-preview-title" data-admin-preview-title-text>Untitled</h3>
            <p class="entry-description" data-admin-preview-description>
              short deck will appear here.
            </p>
            <div class="admin-preview-body post-body" data-admin-preview-body>
              <p>write in markdown and the preview will update here.</p>
            </div>
            <div class="admin-publish-result" data-admin-publish-result hidden>
              <p class="terminal-line">published successfully.</p>
              <a class="terminal-link" href="#" target="_blank" rel="noreferrer" data-admin-live-link>
                open live post
              </a>
            </div>
          </article>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const storageKey = "sporadikspace-admin-draft";
    const authBlock = document.querySelector("[data-admin-auth]");
    const panel = document.querySelector("[data-admin-panel]");
    const passwordInput = document.querySelector("#admin-password");
    const loginButton = document.querySelector("[data-admin-login]");
    const logoutButton = document.querySelector("[data-admin-logout]");
    const form = document.querySelector("[data-admin-form]");
    const feedback = document.querySelector("[data-admin-feedback]");
    const status = document.querySelector("[data-admin-status]");
    const submitButton = document.querySelector("[data-admin-submit]");
    const clearDraftButton = document.querySelector("[data-admin-clear-draft]");
    const entryUrl = document.querySelector("[data-admin-entry-url]");
    const wordCount = document.querySelector("[data-admin-word-count]");
    const previewDate = document.querySelector("[data-admin-preview-date]");
    const previewTitle = document.querySelector("[data-admin-preview-title-text]");
    const previewDescription = document.querySelector("[data-admin-preview-description]");
    const previewBody = document.querySelector("[data-admin-preview-body]");
    const previewImage = document.querySelector("[data-admin-image-preview]");
    const previewImageImg = document.querySelector("[data-admin-image-preview-img]");
    const previewImageCaption = document.querySelector("[data-admin-image-preview-caption]");
    const publishResult = document.querySelector("[data-admin-publish-result]");
    const liveLink = document.querySelector("[data-admin-live-link]");
    const draftNote = document.querySelector("[data-admin-draft-note]");

    if (!form) return;

    const fields = {
      title: form.querySelector('[name="title"]'),
      date: form.querySelector('[name="date"]'),
      description: form.querySelector('[name="description"]'),
      tags: form.querySelector('[name="tags"]'),
      image: form.querySelector('[name="image"]'),
      coverAlt: form.querySelector('[name="coverAlt"]'),
      coverCaption: form.querySelector('[name="coverCaption"]'),
      body: form.querySelector('[name="body"]'),
      draft: form.querySelector('[name="draft"]')
    };

    let currentImageUrl = "";

    function setMessage(message, isError = false) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.dataset.state = isError ? "error" : "ok";
    }

    function setSessionState(authenticated) {
      authBlock.hidden = authenticated;
      panel.hidden = !authenticated;
      if (status) {
        status.textContent = authenticated ? "session ready." : "locked.";
      }
      setMessage("");
    }

    function slugify(value) {
      return value
        .toLocaleLowerCase("tr-TR")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .replace(/-{2,}/g, "-");
    }

    function escapeHtml(value) {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function renderMarkdownPreview(markdown) {
      const trimmed = (markdown || "").trim();
      if (!trimmed) {
        return "<p>write in markdown and the preview will update here.</p>";
      }

      const blocks = trimmed.split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);

      return blocks.map((block) => {
        if (block.startsWith("### ")) {
          return `<h4>${escapeHtml(block.slice(4))}</h4>`;
        }
        if (block.startsWith("## ")) {
          return `<h3>${escapeHtml(block.slice(3))}</h3>`;
        }
        if (block.startsWith("# ")) {
          return `<h2>${escapeHtml(block.slice(2))}</h2>`;
        }
        if (block.startsWith("> ")) {
          const lines = block
            .split("\n")
            .map((line) => line.replace(/^>\s?/, "").trim())
            .filter(Boolean)
            .map((line) => `<p>${escapeHtml(line)}</p>`)
            .join("");
          return `<blockquote>${lines}</blockquote>`;
        }
        return `<p>${escapeHtml(block).replace(/\n/g, "<br />")}</p>`;
      }).join("");
    }

    function countWords(value) {
      const matches = (value || "").trim().match(/\S+/g);
      return matches ? matches.length : 0;
    }

    function saveDraft() {
      const snapshot = {
        title: fields.title.value,
        date: fields.date.value,
        description: fields.description.value,
        tags: fields.tags.value,
        coverAlt: fields.coverAlt.value,
        coverCaption: fields.coverCaption.value,
        body: fields.body.value,
        draft: Boolean(fields.draft.checked)
      };

      localStorage.setItem(storageKey, JSON.stringify(snapshot));
      if (draftNote) {
        draftNote.textContent = "local draft saved on this device";
      }
    }

    function restoreDraft() {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return;

      try {
        const snapshot = JSON.parse(raw);
        fields.title.value = snapshot.title || "";
        fields.date.value = snapshot.date || fields.date.value;
        fields.description.value = snapshot.description || "";
        fields.tags.value = snapshot.tags || "";
        fields.coverAlt.value = snapshot.coverAlt || "";
        fields.coverCaption.value = snapshot.coverCaption || "";
        fields.body.value = snapshot.body || "";
        fields.draft.checked = Boolean(snapshot.draft);
        if (draftNote) {
          draftNote.textContent = "restored local draft from this device";
        }
      } catch {
        localStorage.removeItem(storageKey);
      }
    }

    function clearDraft() {
      localStorage.removeItem(storageKey);
      form.reset();
      fields.date.value = new Date().toISOString().slice(0, 10);
      if (currentImageUrl) {
        URL.revokeObjectURL(currentImageUrl);
        currentImageUrl = "";
      }
      previewImage.hidden = true;
      publishResult.hidden = true;
      if (draftNote) {
        draftNote.textContent = "local draft cleared";
      }
      updatePreview();
      setMessage("local draft cleared.");
    }

    function updateImagePreview() {
      const file = fields.image.files?.[0];
      if (!file) {
        if (currentImageUrl) {
          URL.revokeObjectURL(currentImageUrl);
          currentImageUrl = "";
        }
        previewImage.hidden = true;
        return;
      }

      if (currentImageUrl) {
        URL.revokeObjectURL(currentImageUrl);
      }

      currentImageUrl = URL.createObjectURL(file);
      previewImageImg.src = currentImageUrl;
      previewImageImg.alt = fields.coverAlt.value || fields.title.value || "cover preview";
      previewImageCaption.textContent = fields.coverCaption.value || file.name;
      previewImage.hidden = false;
    }

    function updatePreview() {
      const title = fields.title.value.trim() || "Untitled";
      const date = fields.date.value || new Date().toISOString().slice(0, 10);
      const description = fields.description.value.trim() || "short deck will appear here.";
      const slug = slugify(fields.title.value.trim() || "untitled");
      const body = fields.body.value;
      const words = countWords(body);

      entryUrl.textContent = `/journal/${date}-${slug}/`;
      wordCount.textContent = `${words} word${words === 1 ? "" : "s"}`;
      previewDate.textContent = `[${date}]`;
      previewTitle.textContent = title;
      previewDescription.textContent = description;
      previewBody.innerHTML = renderMarkdownPreview(body);
      updateImagePreview();
      saveDraft();
    }

    async function refreshSession() {
      const response = await fetch("/api/admin/session", { cache: "no-store" });
      const data = await response.json();
      setSessionState(Boolean(data.authenticated));
    }

    async function login() {
      const password = passwordInput.value;
      loginButton.disabled = true;

      try {
        const response = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ password })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Login failed.");
        }

        passwordInput.value = "";
        setSessionState(true);
      } catch (error) {
        setMessage(error.message || "Login failed.", true);
      } finally {
        loginButton.disabled = false;
      }
    }

    async function logout() {
      await fetch("/api/admin/logout", { method: "POST" });
      setSessionState(false);
    }

    async function publish(event) {
      event.preventDefault();
      submitButton.disabled = true;
      setMessage("publishing...");
      publishResult.hidden = true;

      try {
        const formData = new FormData(form);
        formData.set("draft", formData.get("draft") ? "true" : "false");

        const response = await fetch("/api/admin/publish", {
          method: "POST",
          body: formData
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Publish failed.");
        }

        if (liveLink) {
          liveLink.href = data.entryUrl;
          liveLink.textContent = `open live post: ${data.entryUrl}`;
        }
        publishResult.hidden = false;

        localStorage.removeItem(storageKey);
        if (draftNote) {
          draftNote.textContent = "published and cleared from local draft";
        }

        form.reset();
        fields.date.value = new Date().toISOString().slice(0, 10);
        if (currentImageUrl) {
          URL.revokeObjectURL(currentImageUrl);
          currentImageUrl = "";
        }
        previewImage.hidden = true;
        updatePreview();
        setMessage(`published: ${data.filename}`);
      } catch (error) {
        if (error.message === "Authentication required.") {
          setSessionState(false);
        }
        setMessage(error.message || "Publish failed.", true);
      } finally {
        submitButton.disabled = false;
      }
    }

    loginButton?.addEventListener("click", login);
    passwordInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        login();
      }
    });
    logoutButton?.addEventListener("click", logout);
    form?.addEventListener("submit", publish);
    clearDraftButton?.addEventListener("click", clearDraft);

    Object.values(fields).forEach((field) => {
      field?.addEventListener("input", updatePreview);
      field?.addEventListener("change", updatePreview);
    });

    refreshSession().catch(() => {
      setSessionState(false);
      setMessage("admin session could not be checked.", true);
    });

    restoreDraft();
    updatePreview();
  })();
</script>
