---
import BaseLayout from "../layouts/BaseLayout.astro";

const current = new Date();
const today = current.toISOString().slice(0, 10);
const formatter = new Intl.DateTimeFormat("sv-SE", {
  timeZone: "Europe/Istanbul",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false
});
const parts = Object.fromEntries(formatter.formatToParts(current).map((part) => [part.type, part.value]));
const nowLocal = `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`;
---

<BaseLayout title="Admin">
  <section class="terminal-block" aria-labelledby="admin-title">
    <div class="section-head">
      <h1 id="admin-title" class="screen-title">PUBLISH PANEL</h1>
      <p class="muted admin-note">private route for sporadik.space</p>
    </div>

    <div class="admin-shell" data-admin-shell data-admin-ready="false">
      <div class="admin-auth" data-admin-auth>
        <label class="search-label" for="admin-password" data-i18n="admin_password">password</label>
        <div class="admin-inline">
          <input
            id="admin-password"
            class="search-input"
            type="password"
            autocomplete="current-password"
            placeholder="enter admin password"
            data-i18n-placeholder="admin_password"
          />
          <button class="submit-button" type="button" data-admin-login data-i18n="admin_unlock">unlock</button>
        </div>
      </div>

      <div class="admin-panel" data-admin-panel hidden>
        <div class="admin-inline admin-toolbar">
          <p class="terminal-line admin-status" data-admin-status>session ready.</p>
          <div class="admin-toolbar-actions">
            <button class="provider-pill" type="button" data-admin-reset-form data-i18n="admin_new">new entry</button>
          </div>
        </div>

        <div class="admin-summary">
          <p class="admin-summary-label" data-admin-mode-label>new entry</p>
          <p class="admin-summary-value" data-admin-entry-url>/journal/{today}-untitled/</p>
          <div class="admin-summary-meta-row">
            <p class="admin-summary-meta" data-admin-word-count>0 words</p>
            <p class="admin-summary-meta" data-admin-reading-time>1 min read</p>
            <p class="admin-summary-meta" data-admin-status-chip>published</p>
          </div>
        </div>

        <div class="admin-tabs" role="tablist" aria-label="Admin sections">
          <button class="provider-pill" type="button" role="tab" aria-selected="false" data-admin-tab="library" data-i18n="admin_library">library</button>
          <button class="provider-pill active" type="button" role="tab" aria-selected="true" data-admin-tab="write" data-i18n="admin_write">write</button>
        </div>

        <form class="admin-form" data-admin-form>
          <input type="hidden" name="originalPath" value="" />
          <input type="hidden" name="existingCoverImage" value="" />
          <input type="hidden" name="intent" value="published" />
          <input type="hidden" name="status" value="published" />

          <section class="admin-tab-panel active" data-admin-panel-name="write" role="tabpanel">
            <div class="admin-grid">
              <label>
                <span class="search-label">title</span>
                <input class="search-input" type="text" name="title" required />
              </label>

              <label>
                <span class="search-label">date</span>
                <input class="search-input" type="date" name="date" value={today} required />
              </label>
            </div>

            <div class="admin-grid">
              <label>
                <span class="search-label">publish mode</span>
                <select class="search-input" name="publishMode">
                  <option value="published">published</option>
                  <option value="scheduled">scheduled</option>
                  <option value="draft">draft</option>
                </select>
              </label>

              <label data-admin-schedule-wrap hidden>
                <span class="search-label">publish at</span>
                <input class="search-input" type="datetime-local" name="publishAt" value={nowLocal} />
              </label>
            </div>

            <label>
              <span class="search-label">description</span>
              <input class="search-input" type="text" name="description" placeholder="short deck for homepage and meta" />
            </label>

            <label>
              <span class="search-label">tags</span>
              <input class="search-input" type="text" name="tags" placeholder="deneme, notlar, gozlem" />
            </label>

            <label>
              <span class="search-label">body</span>
              <textarea class="search-input admin-textarea" name="body" placeholder="write in markdown..." required></textarea>
            </label>

            <div class="admin-subpanel admin-subpanel-quick">
              <div class="section-head">
                <h2 class="screen-title">QUICK ACTIONS</h2>
                <p class="muted admin-note">save draft, schedule or publish</p>
              </div>
              <div class="admin-quick-actions">
                <button class="provider-pill" type="button" data-admin-quick="draft">save draft</button>
                <button class="provider-pill" type="button" data-admin-quick="scheduled">schedule</button>
                <button class="submit-button" type="button" data-admin-quick="published">publish now</button>
              </div>
            </div>

            <details class="admin-details">
              <summary>cover image</summary>
              <div class="admin-details-body">
                <label>
                  <span class="search-label">upload</span>
                  <input class="search-input admin-file" type="file" name="image" accept="image/*" />
                </label>

                <figure class="admin-image-preview" data-admin-image-preview hidden>
                  <img src="" alt="" data-admin-image-preview-img />
                  <figcaption data-admin-image-preview-caption>cover preview</figcaption>
                </figure>

                <label class="admin-checkbox">
                  <input type="checkbox" name="removeCoverImage" value="true" />
                  <span>remove current cover image</span>
                </label>

                <div class="admin-grid">
                  <label>
                    <span class="search-label">cover alt</span>
                    <input class="search-input" type="text" name="coverAlt" placeholder="short image description" />
                  </label>

                  <label>
                    <span class="search-label">cover caption</span>
                    <input class="search-input" type="text" name="coverCaption" placeholder="optional caption" />
                  </label>
                </div>
              </div>
            </details>

            <details class="admin-details" data-admin-edit-only hidden>
              <summary>tag suggestions</summary>
              <div class="admin-details-body">
                <div class="admin-inline admin-inline-between">
                  <p class="muted admin-note">light suggestions from the current draft</p>
                  <button class="provider-pill" type="button" data-admin-refresh-tags>refresh</button>
                </div>

                <div class="admin-tag-grid">
                  <div>
                    <p class="admin-subtitle">suggested</p>
                    <div class="admin-pill-list" data-admin-tag-suggestions></div>
                  </div>
                  <div>
                    <p class="admin-subtitle">recurring terms</p>
                    <div class="admin-pill-list admin-pill-list-muted" data-admin-recurring-terms></div>
                  </div>
                </div>

                <div class="admin-tag-grid">
                  <div>
                    <p class="admin-subtitle">known site tags</p>
                    <div class="admin-pill-list" data-admin-known-tags></div>
                  </div>
                  <div>
                    <p class="admin-subtitle">warnings</p>
                    <div class="admin-list-compact" data-admin-tag-warnings></div>
                  </div>
                </div>
              </div>
            </details>

            <details class="admin-details" data-admin-edit-only hidden>
              <summary>revisions</summary>
              <div class="admin-details-body">
                <p class="muted admin-note" data-admin-revision-note>load an entry to inspect revisions</p>
                <div class="admin-revision-list" data-admin-revision-list>
                  <p class="terminal-line">no entry loaded yet.</p>
                </div>
              </div>
            </details>

            <details class="admin-details">
              <summary>preview</summary>
              <div class="admin-details-body">
                <article class="admin-preview-card">
                  <p class="entry-date" data-admin-preview-date>[{today}]</p>
                  <h3 class="admin-preview-title" data-admin-preview-title-text>Untitled</h3>
                  <p class="entry-description" data-admin-preview-description>short deck will appear here.</p>
                  <div class="admin-preview-body post-body" data-admin-preview-body>
                    <p>write in markdown and the preview will update here.</p>
                  </div>
                  <div class="admin-publish-result" data-admin-publish-result hidden>
                    <p class="terminal-line">published successfully.</p>
                    <a class="terminal-link" href="#" target="_blank" rel="noreferrer" data-admin-live-link>open live post</a>
                  </div>
                </article>
              </div>
            </details>
          </section>

          <section class="admin-tab-panel" data-admin-panel-name="library" role="tabpanel" hidden>
            <div class="section-head">
              <h2 class="screen-title">EXISTING ENTRIES</h2>
              <p class="muted admin-note" data-admin-library-note>tap an entry to edit or delete</p>
            </div>
            <div class="admin-entry-list" data-admin-entry-list>
              <p class="terminal-line">loading entries...</p>
            </div>
          </section>

          <div class="admin-inline admin-actions">
            <button class="submit-button" type="submit" data-admin-submit data-i18n="admin_publish">publish</button>
            <button class="provider-pill" type="button" data-admin-clear-draft data-i18n="admin_clear">clear local draft</button>
            <p class="terminal-line admin-feedback" data-admin-feedback></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ today, nowLocal }}>
  (() => {
    const storageKey = "sporadikspace-admin-draft-v4";
    const shell = document.querySelector("[data-admin-shell]");
    const authBlock = document.querySelector("[data-admin-auth]");
    const panel = document.querySelector("[data-admin-panel]");
    const passwordInput = document.querySelector("#admin-password");
    const loginButton = document.querySelector("[data-admin-login]");
    const resetFormButton = document.querySelector("[data-admin-reset-form]");
    const form = document.querySelector("[data-admin-form]");
    const feedback = document.querySelector("[data-admin-feedback]");
    const status = document.querySelector("[data-admin-status]");
    const submitButton = document.querySelector("[data-admin-submit]");
    const clearDraftButton = document.querySelector("[data-admin-clear-draft]");
    const scheduleWrap = document.querySelector("[data-admin-schedule-wrap]");
    const entryUrl = document.querySelector("[data-admin-entry-url]");
    const wordCount = document.querySelector("[data-admin-word-count]");
    const readingTime = document.querySelector("[data-admin-reading-time]");
    const statusChip = document.querySelector("[data-admin-status-chip]");
    const previewDate = document.querySelector("[data-admin-preview-date]");
    const previewTitle = document.querySelector("[data-admin-preview-title-text]");
    const previewDescription = document.querySelector("[data-admin-preview-description]");
    const previewBody = document.querySelector("[data-admin-preview-body]");
    const previewImage = document.querySelector("[data-admin-image-preview]");
    const previewImageImg = document.querySelector("[data-admin-image-preview-img]");
    const previewImageCaption = document.querySelector("[data-admin-image-preview-caption]");
    const publishResult = document.querySelector("[data-admin-publish-result]");
    const liveLink = document.querySelector("[data-admin-live-link]");
    const modeLabel = document.querySelector("[data-admin-mode-label]");
    const listContainer = document.querySelector("[data-admin-entry-list]");
    const libraryNote = document.querySelector("[data-admin-library-note]");
    const revisionList = document.querySelector("[data-admin-revision-list]");
    const revisionNote = document.querySelector("[data-admin-revision-note]");
    const tagSuggestions = document.querySelector("[data-admin-tag-suggestions]");
    const recurringTerms = document.querySelector("[data-admin-recurring-terms]");
    const knownTags = document.querySelector("[data-admin-known-tags]");
    const tagWarnings = document.querySelector("[data-admin-tag-warnings]");
    const refreshTagsButton = document.querySelector("[data-admin-refresh-tags]");
    const tabButtons = [...document.querySelectorAll("[data-admin-tab]")];
    const tabPanels = [...document.querySelectorAll("[data-admin-panel-name]")];
    const editOnlyPanels = [...document.querySelectorAll("[data-admin-edit-only]")];

    if (!form) return;

    const fields = {
      originalPath: form.querySelector('[name="originalPath"]'),
      existingCoverImage: form.querySelector('[name="existingCoverImage"]'),
      intent: form.querySelector('[name="intent"]'),
      title: form.querySelector('[name="title"]'),
      date: form.querySelector('[name="date"]'),
      status: form.querySelector('[name="status"]'),
      publishMode: form.querySelector('[name="publishMode"]'),
      publishAt: form.querySelector('[name="publishAt"]'),
      description: form.querySelector('[name="description"]'),
      tags: form.querySelector('[name="tags"]'),
      body: form.querySelector('[name="body"]'),
      image: form.querySelector('[name="image"]'),
      removeCoverImage: form.querySelector('[name="removeCoverImage"]'),
      coverAlt: form.querySelector('[name="coverAlt"]'),
      coverCaption: form.querySelector('[name="coverCaption"]')
    };

    let currentImageUrl = "";
    let currentRemoteImage = "";
    let suppressDraftWrite = false;

    function setMessage(message, state = "") {
      feedback.textContent = message;
      feedback.dataset.state = state;
    }

    function setAuthenticated(authenticated) {
      authBlock.hidden = authenticated;
      panel.hidden = !authenticated;
      status.textContent = authenticated ? "session ready." : "locked.";
      shell.dataset.adminReady = "true";
      setMessage("");
    }

    function setActiveTab(name) {
      tabButtons.forEach((button) => {
        const active = button.dataset.adminTab === name;
        button.classList.toggle("active", active);
        button.setAttribute("aria-selected", String(active));
      });

      tabPanels.forEach((panelNode) => {
        const active = panelNode.dataset.adminPanelName === name;
        panelNode.classList.toggle("active", active);
        panelNode.hidden = !active;
      });
    }

    function isEditingEntry() {
      return Boolean(fields.originalPath.value);
    }

    function setEditingState(editing) {
      editOnlyPanels.forEach((panelNode) => {
        panelNode.hidden = !editing;
        if (!editing) {
          panelNode.open = false;
        }
      });
    }

    function derivePublishMode(statusValue, publishAtValue) {
      if (statusValue === "draft") return "draft";
      if (statusValue === "scheduled" || publishAtValue) return "scheduled";
      return "published";
    }

    function syncPublishMode() {
      const mode = fields.publishMode.value || "published";
      fields.status.value = mode;
      scheduleWrap.hidden = mode !== "scheduled";

      if (mode === "scheduled") {
        if (!fields.publishAt.value) fields.publishAt.value = `${fields.date.value || today}T09:00`;
        return;
      }

      fields.publishAt.value = "";
    }

    function slugify(value) {
      return value
        .toLocaleLowerCase("tr-TR")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .replace(/-{2,}/g, "-");
    }

    function escapeHtml(value) {
      return (value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function renderMarkdownPreview(markdown) {
      const trimmed = (markdown || "").trim();
      if (!trimmed) return "<p>write in markdown and the preview will update here.</p>";
      const blocks = trimmed.split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);
      return blocks
        .map((block) => {
          if (block.startsWith("### ")) return `<h4>${escapeHtml(block.slice(4))}</h4>`;
          if (block.startsWith("## ")) return `<h3>${escapeHtml(block.slice(3))}</h3>`;
          if (block.startsWith("# ")) return `<h2>${escapeHtml(block.slice(2))}</h2>`;
          if (block.startsWith("> ")) {
            const lines = block
              .split("\n")
              .map((line) => line.replace(/^>\s?/, "").trim())
              .filter(Boolean)
              .map((line) => `<p>${escapeHtml(line)}</p>`)
              .join("");
            return `<blockquote>${lines}</blockquote>`;
          }
          return `<p>${escapeHtml(block).replace(/\n/g, "<br />")}</p>`;
        })
        .join("");
    }

    function countWords(value) {
      const matches = (value || "").trim().match(/\S+/g);
      return matches ? matches.length : 0;
    }

    function readingMinutes(words) {
      return Math.max(1, Math.round(words / 225));
    }

    function getDraftSnapshot() {
      return {
        originalPath: fields.originalPath.value,
        existingCoverImage: fields.existingCoverImage.value,
        title: fields.title.value,
        date: fields.date.value,
        publishMode: fields.publishMode.value,
        status: fields.status.value,
        publishAt: fields.publishAt.value,
        description: fields.description.value,
        tags: fields.tags.value,
        body: fields.body.value,
        coverAlt: fields.coverAlt.value,
        coverCaption: fields.coverCaption.value,
        removeCoverImage: Boolean(fields.removeCoverImage.checked),
        activeTab: document.querySelector("[data-admin-tab].active")?.dataset.adminTab || "write"
      };
    }

    function saveDraft() {
      if (suppressDraftWrite) return;
      localStorage.setItem(storageKey, JSON.stringify(getDraftSnapshot()));
    }

    function restoreDraft() {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return;
      try {
        const snapshot = JSON.parse(raw);
        fields.originalPath.value = snapshot.originalPath || "";
        fields.existingCoverImage.value = snapshot.existingCoverImage || "";
        fields.title.value = snapshot.title || "";
        fields.date.value = snapshot.date || fields.date.value;
        fields.publishMode.value = snapshot.publishMode || derivePublishMode(snapshot.status || "published", snapshot.publishAt || "");
        fields.status.value = snapshot.status || fields.publishMode.value || "published";
        fields.publishAt.value = snapshot.publishAt || fields.publishAt.value;
        fields.description.value = snapshot.description || "";
        fields.tags.value = snapshot.tags || "";
        fields.body.value = snapshot.body || "";
        fields.coverAlt.value = snapshot.coverAlt || "";
        fields.coverCaption.value = snapshot.coverCaption || "";
        fields.removeCoverImage.checked = Boolean(snapshot.removeCoverImage);
        currentRemoteImage = fields.existingCoverImage.value || "";
        setActiveTab(snapshot.activeTab || "write");
        syncPublishMode();
        setEditingState(isEditingEntry());
      } catch {
        localStorage.removeItem(storageKey);
      }
    }

    function resetFormState(preservePublishResult = false) {
      suppressDraftWrite = true;
      form.reset();
      fields.originalPath.value = "";
      fields.existingCoverImage.value = "";
      fields.intent.value = "published";
      fields.date.value = today;
      fields.publishMode.value = "published";
      fields.status.value = "published";
      fields.publishAt.value = "";
      fields.removeCoverImage.checked = false;
      currentRemoteImage = "";
      publishResult.hidden = preservePublishResult ? publishResult.hidden : true;
      if (currentImageUrl) {
        URL.revokeObjectURL(currentImageUrl);
        currentImageUrl = "";
      }
      previewImage.hidden = true;
      revisionList.innerHTML = "<p class='terminal-line'>no entry loaded yet.</p>";
      revisionNote.textContent = "load an entry to inspect revisions";
      submitButton.textContent = "publish";
      modeLabel.textContent = "new entry";
      setActiveTab("write");
      syncPublishMode();
      setEditingState(false);
      suppressDraftWrite = false;
    }

    function clearDraft() {
      if (!window.confirm("Clear the local draft?")) return;
      localStorage.removeItem(storageKey);
      resetFormState();
      updatePreview(true);
      setMessage("local draft cleared.");
    }

    function updateImagePreviewFromFile() {
      const file = fields.image.files?.[0];
      if (!file) {
        if (!fields.removeCoverImage.checked && currentRemoteImage) updateImagePreviewFromRemote();
        return;
      }

      if (currentImageUrl) URL.revokeObjectURL(currentImageUrl);
      currentImageUrl = URL.createObjectURL(file);
      previewImageImg.src = currentImageUrl;
      previewImageImg.alt = fields.coverAlt.value || fields.title.value || "cover preview";
      previewImageCaption.textContent = fields.coverCaption.value || file.name;
      previewImage.hidden = false;
    }

    function updateImagePreviewFromRemote() {
      if (fields.removeCoverImage.checked || !currentRemoteImage) {
        previewImage.hidden = true;
        return;
      }

      if (currentImageUrl) {
        URL.revokeObjectURL(currentImageUrl);
        currentImageUrl = "";
      }

      previewImageImg.src = currentRemoteImage;
      previewImageImg.alt = fields.coverAlt.value || fields.title.value || "cover preview";
      previewImageCaption.textContent = fields.coverCaption.value || "current cover image";
      previewImage.hidden = false;
    }

    function statusLabel() {
      return fields.publishMode.value === "draft" ? "draft" : fields.publishMode.value === "scheduled" ? "scheduled" : "published";
    }

    function updatePreview(skipDraftSave = false) {
      const slug = slugify(fields.title.value || "untitled");
      const words = countWords(fields.body.value);
      previewDate.textContent = `[${fields.date.value || today}]`;
      previewTitle.textContent = fields.title.value || "Untitled";
      previewDescription.textContent = fields.description.value || "short deck will appear here.";
      previewBody.innerHTML = renderMarkdownPreview(fields.body.value);
      entryUrl.textContent = `/journal/${fields.date.value || today}-${slug}/`;
      wordCount.textContent = `${words} words`;
      readingTime.textContent = `${readingMinutes(words)} min read`;
      statusChip.textContent = statusLabel();
      if (!skipDraftSave) saveDraft();
    }

    function pillMarkup(items, emptyLabel = "none yet") {
      if (!items?.length) return `<p class="admin-empty">${escapeHtml(emptyLabel)}</p>`;
      return items.map((item) => `<button class="provider-pill" type="button" data-tag-insert="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("");
    }

    function warningMarkup(items) {
      if (!items?.length) return "<p class='admin-empty'>no warnings.</p>";
      return items.map((item) => `<p>${escapeHtml(item)}</p>`).join("");
    }

    function renderLibrary(entries) {
      if (!entries.length) {
        listContainer.innerHTML = "<p class='terminal-line'>no entries found.</p>";
        libraryNote.textContent = "0 entries";
        return;
      }

      const counts = entries.reduce((acc, entry) => {
        acc[entry.effectiveStatus] = (acc[entry.effectiveStatus] || 0) + 1;
        return acc;
      }, {});

      libraryNote.textContent = `${entries.length} entries · ${counts.published || 0} published · ${counts.scheduled || 0} scheduled · ${counts.draft || 0} drafts`;
      listContainer.innerHTML = entries
        .map((entry) => `
          <article class="admin-entry-card">
            <div>
              <div class="admin-inline">
                <p class="entry-date">[${escapeHtml(entry.date)}]</p>
                <span class="admin-status-pill" data-state="${escapeHtml(entry.effectiveStatus)}">${escapeHtml(entry.effectiveStatus)}</span>
              </div>
              <h3 class="admin-entry-title">${escapeHtml(entry.title)}</h3>
              <p class="admin-entry-meta">${entry.wordCount} words · ${entry.readingMinutes} min · ${entry.revisionCount} revisions</p>
            </div>
            <div class="admin-entry-actions">
              <button class="provider-pill" type="button" data-load-entry="${escapeHtml(entry.path)}">edit</button>
              <button class="provider-pill admin-danger" type="button" data-delete-entry="${escapeHtml(entry.path)}">delete</button>
            </div>
          </article>
        `)
        .join("");
    }

    function renderRevisions(revisions) {
      if (!revisions.length) {
        revisionList.innerHTML = "<p class='terminal-line'>no revisions yet for this entry.</p>";
        revisionNote.textContent = "0 saved revisions";
        return;
      }

      revisionList.innerHTML = revisions.map((revision) => `
        <article class="admin-revision-card">
          <div class="admin-inline admin-inline-between">
            <p class="entry-date">${escapeHtml(revision.savedAtLabel)}</p>
            <span class="admin-status-pill" data-state="${escapeHtml(revision.reason)}">${escapeHtml(revision.reason)}</span>
          </div>
          <h3 class="admin-entry-title">${escapeHtml(revision.title)}</h3>
          <p class="admin-entry-meta">${revision.wordCount} words · ${escapeHtml(revision.filename)}</p>
          <div class="admin-entry-actions">
            <button class="provider-pill" type="button" data-restore-revision="${escapeHtml(revision.path)}">restore</button>
          </div>
        </article>
      `).join("");
      revisionNote.textContent = `${revisions.length} saved revisions`;
    }

    async function loadEntries() {
      const response = await fetch("/api/admin/entries", { cache: "no-store" });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not load entries.");
      renderLibrary(data.entries || []);
    }

    async function loadEntry(path) {
      const response = await fetch(`/api/admin/entry?path=${encodeURIComponent(path)}`, { cache: "no-store" });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not load entry.");

      const { entry } = data;
      suppressDraftWrite = true;
      fields.originalPath.value = entry.path || "";
      fields.existingCoverImage.value = entry.coverImage || "";
      fields.title.value = entry.title || "";
      fields.date.value = entry.date || today;
      fields.publishMode.value = derivePublishMode(entry.status || "published", entry.publishAtInput || "");
      fields.status.value = entry.status || "published";
      fields.publishAt.value = entry.publishAtInput || "";
      fields.description.value = entry.description || "";
      fields.tags.value = (entry.tags || []).join(", ");
      fields.body.value = entry.body || "";
      fields.coverAlt.value = entry.coverAlt || "";
      fields.coverCaption.value = entry.coverCaption || "";
      fields.removeCoverImage.checked = false;
      currentRemoteImage = entry.coverImage || "";
      submitButton.textContent = "update";
      modeLabel.textContent = "editing entry";
      suppressDraftWrite = false;
      syncPublishMode();
      setEditingState(true);
      updatePreview(true);
      updateImagePreviewFromRemote();
      await loadRevisions(path);
      setActiveTab("write");
    }

    async function loadRevisions(path) {
      const response = await fetch(`/api/admin/revisions?path=${encodeURIComponent(path)}`, { cache: "no-store" });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not load revisions.");
      renderRevisions(data.revisions || []);
    }

    async function runTagIntelligence() {
      const response = await fetch("/api/admin/tag-intelligence", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          title: fields.title.value,
          description: fields.description.value,
          tags: fields.tags.value,
          body: fields.body.value
        })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not load tag intelligence.");

      tagSuggestions.innerHTML = pillMarkup(data.suggestedTags, "no tag suggestions yet.");
      recurringTerms.innerHTML = pillMarkup(data.recurringTerms, "no recurring terms yet.");
      knownTags.innerHTML = pillMarkup(data.knownTags, "no known tags yet.");
      tagWarnings.innerHTML = warningMarkup(data.warnings);
    }

    async function deleteEntry(path) {
      if (!window.confirm("Delete this entry? A revision snapshot will be kept.")) return;
      setMessage("deleting entry...");
      const response = await fetch("/api/admin/entry", {
        method: "DELETE",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not delete entry.");
      setMessage("entry deleted.");
      if (fields.originalPath.value === path) clearDraft();
      await loadEntries();
    }

    async function restoreRevision(path) {
      if (!window.confirm("Restore this revision? Current version will be snapshotted first.")) return;
      setMessage("restoring revision...");
      const response = await fetch("/api/admin/revision/restore", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ revisionPath: path })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not restore revision.");
      setMessage("revision restored.");
      if (data.entryPath) await loadEntry(data.entryPath);
      await loadEntries();
    }

    async function verifySession() {
      const response = await fetch("/api/admin/session", { cache: "no-store" });
      setAuthenticated(response.ok);
      if (response.ok) {
        await Promise.all([loadEntries(), runTagIntelligence().catch(() => null)]);
      }
    }

    async function login() {
      setMessage("");
      try {
        const response = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ password: passwordInput.value })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Login failed.");
        passwordInput.value = "";
        await verifySession();
        updatePreview(true);
      } catch (error) {
        setMessage(error.message || "Login failed.", "error");
      }
    }

    function applyQuickIntent(intent) {
      fields.intent.value = intent;
      if (intent === "draft") {
        fields.publishMode.value = "draft";
      } else if (intent === "scheduled") {
        fields.publishMode.value = "scheduled";
      } else {
        fields.publishMode.value = "published";
      }
      syncPublishMode();
      updatePreview();
      form.requestSubmit();
    }

    async function submitForm(event) {
      event.preventDefault();
      setMessage("publishing...");
      submitButton.disabled = true;
      try {
        const formData = new FormData(form);
        syncPublishMode();
        formData.set("removeCoverImage", formData.get("removeCoverImage") ? "true" : "false");
        formData.set("status", fields.status.value);
        formData.set("publishAt", fields.publishAt.value);
        const response = await fetch("/api/admin/publish", { method: "POST", body: formData });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Publish failed.");

        setMessage("saved.");
        fields.originalPath.value = data.entryPath || "";
        fields.existingCoverImage.value = data.coverImage || "";
        currentRemoteImage = data.coverImage || "";
        modeLabel.textContent = "editing entry";
        submitButton.textContent = "update";
        liveLink.href = data.entryUrl || "#";
        publishResult.hidden = false;
        fields.intent.value = "published";
        localStorage.removeItem(storageKey);
        updatePreview(true);
        updateImagePreviewFromRemote();
        if (data.entryPath) await loadRevisions(data.entryPath);
        await loadEntries();
        setEditingState(true);
      } catch (error) {
        setMessage(error.message || "Publish failed.", "error");
      } finally {
        submitButton.disabled = false;
      }
    }

    loginButton?.addEventListener("click", login);
    passwordInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        login();
      }
    });

    resetFormButton?.addEventListener("click", () => {
      resetFormState();
      updatePreview(true);
      setMessage("fresh entry ready.");
    });
    clearDraftButton?.addEventListener("click", clearDraft);
    form.addEventListener("submit", submitForm);

    refreshTagsButton?.addEventListener("click", async () => {
      setMessage("refreshing tag suggestions...");
      try {
        await runTagIntelligence();
        setMessage("tag suggestions refreshed.");
      } catch (error) {
        setMessage(error.message || "Could not refresh suggestions.", "error");
      }
    });

    form.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-tag-insert]");
      if (!button) return;
      const value = button.dataset.tagInsert;
      const current = fields.tags.value
        .split(",")
        .map((item) => item.trim())
        .filter(Boolean);
      if (!current.includes(value)) {
        current.push(value);
        fields.tags.value = current.join(", ");
        updatePreview();
      }
    });

    listContainer?.addEventListener("click", async (event) => {
      const loadButton = event.target.closest("button[data-load-entry]");
      const deleteButton = event.target.closest("button[data-delete-entry]");

      try {
        if (loadButton) {
          setMessage("loading entry...");
          await loadEntry(loadButton.dataset.loadEntry);
          setMessage("entry loaded.");
          return;
        }

        if (deleteButton) {
          await deleteEntry(deleteButton.dataset.deleteEntry);
        }
      } catch (error) {
        setMessage(error.message || "Action failed.", "error");
      }
    });

    revisionList?.addEventListener("click", async (event) => {
      const button = event.target.closest("button[data-restore-revision]");
      if (!button) return;
      try {
        await restoreRevision(button.dataset.restoreRevision);
      } catch (error) {
        setMessage(error.message || "Could not restore revision.", "error");
      }
    });

    tabButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const nextTab = button.dataset.adminTab;
        setActiveTab(nextTab);
        saveDraft();
        if (nextTab === "library") {
          try {
            await loadEntries();
          } catch (error) {
            setMessage(error.message || "Could not refresh library.", "error");
          }
        }
      });
    });

    [
      fields.title,
      fields.date,
      fields.publishMode,
      fields.publishAt,
      fields.description,
      fields.tags,
      fields.body,
      fields.coverAlt,
      fields.coverCaption
    ].forEach((field) => field?.addEventListener("input", () => updatePreview()));

    fields.publishMode?.addEventListener("change", () => {
      syncPublishMode();
      updatePreview();
    });

    fields.date?.addEventListener("change", () => {
      if (fields.publishMode.value === "scheduled" && !fields.publishAt.value) {
        fields.publishAt.value = `${fields.date.value || today}T09:00`;
      }
      updatePreview();
    });

    fields.image?.addEventListener("change", () => {
      fields.removeCoverImage.checked = false;
      updateImagePreviewFromFile();
      saveDraft();
    });

    fields.removeCoverImage?.addEventListener("change", () => {
      if (fields.removeCoverImage.checked) {
        previewImage.hidden = true;
      } else if (fields.image.files?.[0]) {
        updateImagePreviewFromFile();
      } else {
        updateImagePreviewFromRemote();
      }
      saveDraft();
    });

    restoreDraft();
    syncPublishMode();
    setEditingState(isEditingEntry());
    updatePreview(true);
    updateImagePreviewFromRemote();
    verifySession().catch(() => {
      shell.dataset.adminReady = "true";
      setAuthenticated(false);
    });
  })();
</script>
