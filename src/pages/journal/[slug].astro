---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  entryDate,
  entrySlug,
  entryStatus,
  entryTitle,
  entryUrl,
  formatDate,
  publishedEntries
} from "../../lib/journal";

export async function getStaticPaths() {
  const entries = publishedEntries(await getCollection("journal"));
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
if (entryStatus(entry) !== "published") {
  throw new Error(`Attempted to render unpublished entry: ${entry.id}`);
}

const { Content } = await render(entry);
const coverImage = entry.data.coverImage ?? "";
const coverPosition = `${entry.data.coverFocusX ?? 50}% ${entry.data.coverFocusY ?? 50}%`;
const shareUrl = new URL(entryUrl(entry), Astro.site ?? Astro.url).toString();
const shareTitle = entryTitle(entry);
const shareText = `${shareTitle} - sporadik.space`;
---

<BaseLayout
  title={entryTitle(entry)}
  description={entry.data.description || entryTitle(entry)}
  canonicalPath={entryUrl(entry)}
  type="article"
  ogImage={coverImage || undefined}
  ogImageAlt={entry.data.coverAlt || entryTitle(entry)}
>
  <article class="terminal-block">
    <a href="/" class="terminal-link back-link" data-i18n="journal_back">&lt; return to index</a>
    <h1 class="post-title">{entryTitle(entry)}</h1>
    <div class="post-meta">
      <span data-localize-date="long" data-date-iso={entryDate(entry).toISOString()}>
        [{formatDate(entryDate(entry))}]
      </span>
      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list" role="list">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </div>
    {
      entry.data.coverImage && (
        <figure class="post-cover">
          <img
            src={entry.data.coverImage}
            alt={entry.data.coverAlt ?? ""}
            style={`object-position:${coverPosition};`}
          />
          {entry.data.coverCaption && <figcaption>{entry.data.coverCaption}</figcaption>}
        </figure>
      )
    }
    <div class="post-body">
      <Content />
    </div>

    <div class="post-share" aria-label="Share this entry">
      <span class="post-share-label" data-i18n="journal_share">share</span>
      <a
        class="post-share-link"
        href={`https://x.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noreferrer"
      >
        X
      </a>
      <a
        class="post-share-link"
        href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTitle)}`}
        target="_blank"
        rel="noreferrer"
      >
        Telegram
      </a>
      <a
        class="post-share-link"
        href={`https://wa.me/?text=${encodeURIComponent(`${shareTitle} ${shareUrl}`)}`}
        target="_blank"
        rel="noreferrer"
      >
        WhatsApp
      </a>
      <button class="post-share-link post-share-copy" type="button" data-copy-share={shareUrl} data-i18n="journal_copy">
        Copy
      </button>
    </div>
  </article>

  {
    coverImage && (
      <script is:inline define:vars={{ coverImage }}>
        (() => {
          const postBody = document.querySelector(".post-body");
          if (!postBody) return;

          const normalize = (value) => {
            try {
              return new URL(value, window.location.origin).pathname;
            } catch {
              return value;
            }
          };

          const targetPath = normalize(coverImage);
          const duplicateImage = Array.from(postBody.querySelectorAll("img")).find(
            (image) => normalize(image.getAttribute("src") ?? "") === targetPath
          );

          if (!duplicateImage) return;

          const removableWrapper = duplicateImage.closest("p, figure");

          if (removableWrapper && removableWrapper.parentElement === postBody) {
            removableWrapper.remove();
            return;
          }

          duplicateImage.remove();
        })();
      </script>
    )
  }

  <script is:inline>
    (() => {
      const copyButton = document.querySelector("[data-copy-share]");
      if (!copyButton) return;
      const t = window.__sporadikT || ((key) => ({ journal_copy: "Copy", journal_copied: "Copied" }[key] || key));

      copyButton.addEventListener("click", async () => {
        const shareUrl = copyButton.dataset.copyShare;
        if (!shareUrl) return;

        try {
          await navigator.clipboard.writeText(shareUrl);
          copyButton.textContent = t("journal_copied");
          window.setTimeout(() => {
            copyButton.textContent = t("journal_copy");
          }, 1400);
        } catch {
          copyButton.textContent = t("journal_copy");
          window.setTimeout(() => {
            copyButton.textContent = t("journal_copy");
          }, 1400);
        }
      });
    })();
  </script>
</BaseLayout>
