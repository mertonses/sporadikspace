---
import "../styles/global.css";
import "../styles/ui-overrides.css";

import SiteHeader from "../components/SiteHeader.astro";
import { siteConfig } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  ogImage,
  ogImageAlt = `${siteConfig.title} paylasim gorseli`
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, siteOrigin);
const ogImageUrl = new URL(ogImage || "/og.svg", siteOrigin);
const ogImageType = (() => {
  const pathname = ogImageUrl.pathname.toLowerCase();
  if (pathname.endsWith(".png")) return "image/png";
  if (pathname.endsWith(".webp")) return "image/webp";
  if (pathname.endsWith(".svg")) return "image/svg+xml";
  return "image/jpeg";
})();

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
---

<!doctype html>
<html lang="en" data-theme="system" data-locale="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        const themeStorageKey = "sporadikspace-theme";
        const validThemes = ["light", "dark", "system"];
        const browserLocale = (navigator.language || "en").toLowerCase().startsWith("tr") ? "tr" : "en";

        try {
          const savedTheme = localStorage.getItem(themeStorageKey);
          document.documentElement.dataset.theme = validThemes.includes(savedTheme) ? savedTheme : "system";
        } catch {
          document.documentElement.dataset.theme = "system";
        }

        document.documentElement.lang = browserLocale;
        document.documentElement.dataset.locale = browserLocale;
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#e8e2d6" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:site" content="@sporadikspace" />
    <meta name="twitter:creator" content="@sporadikspace" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body>
    <div class="shell">
      <SiteHeader />

      <main>
        <slot />
      </main>

      <footer class="footer">
        <p>
          <a href="/rss.xml" data-i18n="footer_rss">RSS</a>
        </p>
      </footer>
    </div>
  </body>

  <script is:inline>
    (() => {
      const locale = document.documentElement.dataset.locale === "tr" ? "tr" : "en";

      const dictionary = {
        tr: {
          nav_latest: "son yazılar",
          nav_archive: "arşiv",
          nav_search: "arama",
          nav_subscribe: "abone ol",
          footer_rss: "RSS",
          home_boot_1: "> sporadikspace başlatılıyor...",
          home_boot_2: "> yazı dizini yükleniyor...",
          home_boot_3: "> hazır.",
          home_latest: "SON YAZILAR",
          home_archive: "ARŞİV",
          tag_search: "arama",
          tag_empty: "henüz etiket yok.",
          archive_boot: "> arşiv dizini hazır.",
          archive_title: "ARŞİV",
          subscribe_prompt: "> sporadikspace bültenine abone ol",
          subscribe_title: "ABONE OL",
          subscribe_email: "e-posta",
          subscribe_button: "abone ol",
          subscribe_unavailable: "abonelik şu anda hazır değil.",
          search_title: "ARAMA",
          search_query: "sorgu",
          search_placeholder: "> yazılarda ara",
          search_idle: "yazmaya başla.",
          search_unavailable: "arama dizini şu an kullanılamıyor.",
          search_no_match: "eşleşen yazı yok.",
          search_ready: "{count} yazı hazır.",
          search_matches_one: "1 eşleşme.",
          search_matches_many: "{count} eşleşme.",
          journal_back: "< ana sayfaya dön",
          journal_share: "paylaş",
          journal_copy: "Kopyala",
          journal_copied: "Kopyalandı",
          admin_password: "şifre",
          admin_unlock: "aç",
          admin_new: "yeni yazı",
          admin_lock: "kilitle",
          admin_write: "yazı",
          admin_library: "arşiv",
          admin_publish: "yayınla",
          admin_update: "güncelle",
          admin_clear: "taslağı temizle"
        },
        en: {
          nav_latest: "latest",
          nav_archive: "archive",
          nav_search: "search",
          nav_subscribe: "subscribe",
          footer_rss: "RSS",
          home_boot_1: "> booting sporadikspace...",
          home_boot_2: "> loading journal index...",
          home_boot_3: "> ready.",
          home_latest: "LATEST ENTRIES",
          home_archive: "ARCHIVE",
          tag_search: "search",
          tag_empty: "no tags yet.",
          archive_boot: "> archive index online.",
          archive_title: "ARCHIVE",
          subscribe_prompt: "> subscribe to sporadikspace",
          subscribe_title: "SUBSCRIBE",
          subscribe_email: "email",
          subscribe_button: "subscribe",
          subscribe_unavailable: "subscription is not available yet.",
          search_title: "SEARCH",
          search_query: "query",
          search_placeholder: "> search the log",
          search_idle: "type to begin.",
          search_unavailable: "search index unavailable.",
          search_no_match: "no matching entries.",
          search_ready: "{count} indexed entries ready.",
          search_matches_one: "1 match.",
          search_matches_many: "{count} matches.",
          journal_back: "< return to index",
          journal_share: "share",
          journal_copy: "Copy",
          journal_copied: "Copied",
          admin_password: "password",
          admin_unlock: "unlock",
          admin_new: "new entry",
          admin_lock: "lock",
          admin_write: "write",
          admin_library: "library",
          admin_publish: "publish",
          admin_update: "update",
          admin_clear: "clear local draft"
        }
      };

      const t = (key, vars = {}) => {
        const raw = dictionary[locale]?.[key] || dictionary.en[key] || key;
        return Object.entries(vars).reduce(
          (value, [name, replacement]) => value.replaceAll(`{${name}}`, String(replacement)),
          raw
        );
      };

      document.querySelectorAll("[data-i18n]").forEach((node) => {
        node.textContent = t(node.dataset.i18n);
      });

      document.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
        node.setAttribute("placeholder", t(node.dataset.i18nPlaceholder));
      });

      document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
        node.setAttribute("aria-label", t(node.dataset.i18nAriaLabel));
      });

      const longDateFormatter = new Intl.DateTimeFormat(
        locale === "tr" ? "tr-TR" : "en-GB",
        {
          year: "numeric",
          month: "long",
          day: "2-digit",
          timeZone: "UTC"
        }
      );

      const monthFormatter = new Intl.DateTimeFormat(
        locale === "tr" ? "tr-TR" : "en-US",
        {
          month: "long",
          timeZone: "UTC"
        }
      );

      document.querySelectorAll("[data-localize-date]").forEach((node) => {
        const iso = node.getAttribute("data-date-iso");
        if (!iso) return;

        const date = new Date(iso);
        if (Number.isNaN(date.getTime())) return;

        node.textContent = `[${longDateFormatter.format(date)}]`;
      });

      document.querySelectorAll("[data-localize-month]").forEach((node) => {
        const year = node.getAttribute("data-year");
        const month = node.getAttribute("data-month");
        if (!year || !month) return;

        const date = new Date(`${year}-${month}-01T00:00:00.000Z`);
        if (Number.isNaN(date.getTime())) return;

        node.textContent = monthFormatter.format(date);
      });

      window.__sporadikLocale = locale;
      window.__sporadikT = t;
    })();
  </script>
</html>
