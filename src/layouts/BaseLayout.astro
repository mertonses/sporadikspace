---
import "../styles/global.css";
import "../styles/ui-overrides.css";

import SiteHeader from "../components/SiteHeader.astro";
import { siteConfig } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  type = "website",
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

const canonicalUrl = new URL(canonicalPath, siteOrigin);
const ogImageUrl = new URL("/og.svg", siteOrigin);

const pageTitle =
  title === siteConfig.title
    ? title
    : `${title} | ${siteConfig.title}`;
---

<!doctype html>
<html lang="tr" data-theme="system">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <!--
      Tema tercihini CSS yüklenmeden önce uygular.
      Böylece sayfa açılırken yanlış tema parlaması azalır.
    -->
    <script is:inline>
      (() => {
        const storageKey = "sporadikspace-theme";
        const validThemes = ["light", "dark", "system"];

        try {
          const savedTheme = localStorage.getItem(storageKey);

          document.documentElement.dataset.theme =
            validThemes.includes(savedTheme)
              ? savedTheme
              : "system";
        } catch {
          document.documentElement.dataset.theme = "system";
        }
      })();
    </script>

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />

    <meta
      name="theme-color"
      content="#e8e2d6"
    />

    <link rel="canonical" href={canonicalUrl} />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href="/rss.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:image:alt"
      content={`${siteConfig.title} paylaşım görseli`}
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta
      name="twitter:image:alt"
      content={`${siteConfig.title} paylaşım görseli`}
    />
  </head>

  <body>
    <div class="shell">
      <SiteHeader />

      <main>
        <slot />
      </main>

      <footer class="footer">
        <p>
          source of truth: markdown files.
          <span aria-hidden="true"> · </span>
          <a href="/rss.xml">RSS</a>
        </p>
      </footer>
    </div>
  </body>
</html>