---
const source = "/search-index.json";
---

<section class="terminal-block search-block" aria-labelledby="search-heading">
  <h1 id="search-heading" class="screen-title" data-i18n="search_title">SEARCH</h1>
  <p class="terminal-line">&gt; title / content / tags</p>

  <label class="search-label" for="search-input" data-i18n="search_query">query</label>
  <input
    id="search-input"
    class="search-input"
    type="search"
    name="q"
    placeholder="> search the log"
    data-i18n-placeholder="search_placeholder"
    autocomplete="off"
  />

  <div class="search-status" id="search-status" data-i18n="search_idle">type to begin.</div>
  <ul class="entry-list search-results" id="search-results"></ul>
</section>

<script type="module" define:vars={{ source }}>
  const input = document.getElementById("search-input");
  const list = document.getElementById("search-results");
  const status = document.getElementById("search-status");
  const params = new URLSearchParams(window.location.search);
  const t = window.__sporadikT || ((key, vars = {}) => {
    const messages = {
      search_idle: "type to begin.",
      search_unavailable: "search index unavailable.",
      search_no_match: "no matching entries.",
      search_ready: "{count} indexed entries ready.",
      search_matches_one: "1 match.",
      search_matches_many: "{count} matches."
    };
    return Object.entries(vars).reduce((value, [name, replacement]) => value.replaceAll(`{${name}}`, String(replacement)), messages[key] || key);
  });

  let entries = [];

  async function boot() {
    try {
      const response = await fetch(source);
      entries = await response.json();
      status.textContent = t("search_ready", { count: entries.length });
    } catch {
      status.textContent = t("search_unavailable");
    }
  }

  function render(items) {
    list.innerHTML = "";
    if (!items.length) {
      status.textContent = t("search_no_match");
      return;
    }

    status.textContent = items.length === 1 ? t("search_matches_one") : t("search_matches_many", { count: items.length });

    for (const item of items) {
      const li = document.createElement("li");
      li.className = "entry-row";
      const link = document.createElement("a");
      link.className = "entry-link";
      link.href = `/journal/${encodeURIComponent(item.slug)}/`;

      const date = document.createElement("span");
      date.className = "entry-date";
      date.textContent = `[${item.date}]`;

      const title = document.createElement("span");
      title.className = "entry-title";
      title.textContent = item.title || "";

      link.append(date, title);

      if (item.description) {
        const description = document.createElement("span");
        description.className = "entry-description";
        description.textContent = item.description;
        link.append(description);
      }

      li.append(link);
      list.appendChild(li);
    }
  }

  input?.addEventListener("input", (event) => {
    const query = event.target.value.trim().toLowerCase();
    if (!query) {
      list.innerHTML = "";
      status.textContent = t("search_ready", { count: entries.length });
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.delete("q");
      window.history.replaceState({}, "", nextUrl);
      return;
    }

    const matches = entries.filter((entry) => {
      return [entry.title, entry.description, entry.tags.join(" "), entry.body]
        .join(" ")
        .toLowerCase()
        .includes(query);
    });

    const nextUrl = new URL(window.location.href);
    nextUrl.searchParams.set("q", event.target.value.trim());
    window.history.replaceState({}, "", nextUrl);

    render(matches);
  });

  boot().then(() => {
    const initialQuery = params.get("q")?.trim();
    if (!initialQuery || !input) return;
    input.value = initialQuery;
    input.dispatchEvent(new Event("input", { bubbles: true }));
  });
</script>
