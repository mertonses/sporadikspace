---
const pathname = Astro.url.pathname;
const BrandHeading = pathname === "/" ? "h1" : "div";

const isCurrent = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname.startsWith(href);
};
---

<header class="masthead">
  <BrandHeading class="site-name">
    <a href="/" class="brand" aria-label="sporadik.space">
      <span class="brand-type">
        <span class="brand-name">sporadik</span>
        <span class="brand-suffix" aria-hidden="true">.space</span>
      </span>
    </a>
  </BrandHeading>
  {pathname === "/" && (
    <p class="site-deck" data-i18n="home_deck">Essays, notes and observations</p>
  )}

  <div class="masthead-tools">
    <nav aria-label="Ana navigasyon">
      <ul class="nav-list">
        <li>
          <a
            href="/"
            aria-current={isCurrent("/") ? "page" : undefined}
            data-i18n="nav_latest"
          >
            writing
          </a>
        </li>

        <li>
          <a
            href="/archive"
            aria-current={isCurrent("/archive") ? "page" : undefined}
            data-i18n="nav_archive"
          >
            archive
          </a>
        </li>

        <li>
          <a
            href="/search"
            aria-current={isCurrent("/search") ? "page" : undefined}
            data-i18n="nav_search"
          >
            search
          </a>
        </li>

        <li>
          <a
            href="/subscribe"
            aria-current={isCurrent("/subscribe") ? "page" : undefined}
            data-i18n="nav_subscribe"
          >
            subscribe
          </a>
        </li>
      </ul>
    </nav>

    <div
      class="theme-switcher"
      role="group"
      aria-label="Renk teması"
    >
      <button
        type="button"
        class="theme-button"
        data-theme-value="light"
        aria-label="Açık temayı kullan"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 6.7 6.7M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
        </svg>
        <span class="sr-only">Açık tema</span>
      </button>

      <button
        type="button"
        class="theme-button"
        data-theme-value="dark"
        aria-label="Koyu temayı kullan"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path>
        </svg>
        <span class="sr-only">Koyu tema</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const storageKey = "sporadikspace-theme";
    const validThemes = ["light", "dark", "system"];

    const root = document.documentElement;
    const themeColorMeta = document.querySelector(
      'meta[name="theme-color"]'
    );

    const systemDarkQuery = window.matchMedia(
      "(prefers-color-scheme: dark)"
    );

    const buttons = Array.from(
      document.querySelectorAll("[data-theme-value]")
    );

    function getStoredTheme() {
      try {
        const storedTheme = localStorage.getItem(storageKey);

        return validThemes.includes(storedTheme)
          ? storedTheme
          : "system";
      } catch {
        return "system";
      }
    }

    function getResolvedTheme(theme) {
      if (theme === "system") {
        return systemDarkQuery.matches ? "dark" : "light";
      }

      return theme;
    }

    function updateThemeColor(theme) {
      if (!themeColorMeta) {
        return;
      }

      const resolvedTheme = getResolvedTheme(theme);

      themeColorMeta.setAttribute(
        "content",
        resolvedTheme === "dark"
          ? "#10110e"
          : "#e8e2d6"
      );
    }

    function updateButtons(theme) {
      const resolvedTheme = getResolvedTheme(theme);

      buttons.forEach((button) => {
        const buttonTheme = button.dataset.themeValue;
        const isActive = buttonTheme === resolvedTheme;

        button.setAttribute(
          "aria-pressed",
          isActive ? "true" : "false"
        );

        button.classList.toggle("active", isActive);
      });
    }

    function applyTheme(theme, save = true) {
      const safeTheme = validThemes.includes(theme)
        ? theme
        : "system";

      root.dataset.theme = safeTheme;

      updateButtons(safeTheme);
      updateThemeColor(safeTheme);

      if (save) {
        try {
          localStorage.setItem(storageKey, safeTheme);
        } catch {
          // localStorage kullanılamıyorsa seçim yalnızca
          // mevcut oturumda uygulanır.
        }
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        applyTheme(button.dataset.themeValue);
      });
    });

    systemDarkQuery.addEventListener("change", () => {
      if (root.dataset.theme === "system") {
        updateThemeColor("system");
      }
    });

    applyTheme(getStoredTheme(), false);
  })();
</script>


<style>
  .site-name {
    margin: 0;
    font-weight: 500;
    line-height: 1;
  }

  .site-name .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    padding-right: 0;
    line-height: 1;
    cursor: pointer;
  }

  .brand-name {
    font-size: clamp(2.65rem, 8vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
  }

  .brand-suffix {
    color: var(--text-secondary);
    font-family: var(--font-meta);
    font-size: clamp(0.78rem, 1.7vw, 1rem);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .brand-suffix b {
    color: var(--accent);
    font-weight: 500;
  }

  .site-name .brand:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .site-deck {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-reading);
    font-size: 1.0625rem;
  }

  .masthead .masthead-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .masthead .nav-list,
  .masthead .theme-switcher {
    margin-top: 0;
  }

  .masthead .theme-switcher {
    position: static;
    gap: 0.15rem;
    padding: 0.2rem;
    border-radius: 999px;
  }

  .masthead .theme-button {
    display: grid;
    width: 2.15rem;
    min-height: 2.15rem;
    padding: 0;
    place-items: center;
    border-radius: 50%;
  }

  .theme-button svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-list a {
    display: inline-block;
    padding-block: 0.4rem;
  }
</style>
